FROM python:3.12-slim
WORKDIR /src
COPY epm-mcp-standin.zip .
RUN python -c "import zipfile; zipfile.ZipFile('epm-mcp-standin.zip').extractall('.')" && pip install --no-cache-dir -r epm-mcp-standin/requirements.txt
COPY overlay/oracle_fccs.py epm-mcp-standin/app/oracle_fccs.py
COPY overlay/fccs_live_server.py epm-mcp-standin/app/fccs_live_server.py
WORKDIR /src/epm-mcp-standin
ENV PORT=8000
EXPOSE 8000
USER nobody
CMD ["python", "-m", "app.fccs_live_server"]
